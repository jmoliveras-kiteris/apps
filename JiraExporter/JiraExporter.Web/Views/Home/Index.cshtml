@model JiraExporter.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Incurridos Jira - Dashboard";
}

<!-- Loading Overlay -->
<div id="globalLoader" class="loader-overlay d-none">
    <div class="loader-content text-center">
        <div class="spinner-grow text-info mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
        <h4 class="text-white fw-bold">PROCESANDO INCURRIDOS</h4>
        <p class="text-white-50 small x-small tracking-widest text-uppercase">Obteniendo información...</p>
    </div>
</div>

<div class="container-fluid p-0 dashboard-root">
    <div class="row g-0 main-layout">
        <aside class="col-lg-3 col-xl-2 bg-white border-end shadow-sm sidebar-wrapper d-flex flex-column h-100 overflow-hidden">
            <form id="dashboardForm" method="get" action="@Url.Action("Index", "Home")" onsubmit="showLoader()" class="d-flex flex-column h-100">
                <div class="sidebar-scroll-area flex-grow-1 overflow-auto p-4 custom-scrollbar">
                    <div class="sidebar-header mb-5 text-center">
                         <i class="bi bi-rocket-takeoff-fill fs-2 text-primary mb-2 d-block"></i>
                         <h2 class="h6 fw-bold text-dark text-uppercase tracking-widest">Incurridos Jira</h2>
                         <div class="stat-sidebar mt-3 p-3 rounded-4 bg-dark text-white shadow-sm">
                            <div class="x-small text-muted-emphasis fw-bold mb-1">TOTAL HORAS</div>
                            <div id="totalHoursValue" class="h4 fw-black text-info mb-0">@Model.Worklogs.Sum(x => x.Hours).ToString("F2")</div>
                         </div>
                         <button type="button" onclick="exportData()" class="btn btn-outline-info btn-sm w-100 rounded-pill fw-bold mt-3 hvr-push shadow-sm">
                            <i class="bi bi-file-earmark-excel me-1"></i> EXPORTAR CSV
                         </button>
                    </div>

                    <div class="filter-group mb-5">
                        <h6 class="text-uppercase fw-bold text-muted small tracking-widest mb-4">
                            <i class="bi bi-calendar2-range me-2"></i>Rango de Fechas
                        </h6>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">DESDE</label>
                            <input asp-for="DateFrom" type="date" class="form-control modern-input" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">HASTA</label>
                            <input asp-for="DateTo" type="date" class="form-control modern-input" />
                        </div>
                    </div>

                    <div class="filter-group mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h6 class="text-uppercase fw-bold text-muted small tracking-widest mb-0">
                                <i class="bi bi-people me-2"></i>Equipo
                            </h6>
                            <div class="form-check m-0">
                                <input class="form-check-input" type="checkbox" id="selectAllSidebar" @(Model.SelectedUsers.Count == Model.AvailableUsers.Count ? "checked" : "")>
                                <label class="form-check-label small fw-bold text-muted" for="selectAllSidebar">TODOS</label>
                            </div>
                        </div>
                        <div class="user-selection-list">
                            @for (var i = 0; i < Model.AvailableUsers.Count; i++)
                            {
                                <div class="form-check py-2 px-3 mb-1 rounded-3 user-selection-item transition-all border-bottom border-light">
                                    <input class="form-check-input user-cb-sidebar" type="checkbox" name="SelectedUsers" 
                                           value="@Model.AvailableUsers[i]" id="s_user_@i"
                                           @(Model.SelectedUsers.Contains(Model.AvailableUsers[i]) ? "checked" : "")>
                                    <label class="form-check-label small fw-semibold text-dark w-100 cursor-pointer" for="s_user_@i">
                                        @Model.AvailableUsers[i]
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="sidebar-footer p-4 bg-white border-top mt-auto">
                    <button type="submit" id="searchBtn" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm hvr-grow d-flex align-items-center justify-content-center">
                        <i class="bi bi-search me-2"></i>BUSCAR
                    </button>
                    <p class="text-center x-small text-muted mt-2 mb-0">Sincronización en vivo</p>
                </div>
            </form>
        </aside>

        <!-- Main Content -->
        <main class="col-lg-9 col-xl-10 p-4 bg-light overflow-hidden d-flex flex-column h-100">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden flex-grow-1 d-flex flex-column">
                <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center flex-shrink-0">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-table me-2 text-info"></i>Registros de Actividad</h5>
                    <div class="ms-auto d-flex gap-3">
                        <span id="recordCountBadge" class="badge bg-light text-dark border px-4 py-2 rounded-pill fs-6 fw-normal">@Model.Worklogs.Count Registros Encontrados</span>
                    </div>
                </div>
                
                <div class="table-container flex-grow-1 overflow-auto custom-scrollbar">
                    <table id="worklogTable" class="table table-hover align-middle mb-0" style="table-layout: fixed; width: 100%;">
                        <thead class="bg-light sticky-top shadow-card" style="z-index: 20;">
                            <!-- Column Filters & Sorting Headers -->
                            <tr class="header-controls">
                                <th class="ps-4 sortable pointer" onclick="sortTable(0)" style="width: 100px;">
                                    <div class="d-flex align-items-center">FECHA <i class="bi bi-arrow-down-up ms-2 x-small opacity-50"></i></div>
                                </th>
                                <th class="sortable pointer" onclick="sortTable(1)" style="width: 250px;">
                                    <div class="d-flex align-items-center mb-1">USUARIO <i class="bi bi-arrow-down-up ms-2 x-small opacity-50"></i></div>
                                    <input form="dashboardForm" asp-for="FilterUser" class="form-control form-control-sm header-filter" placeholder="Filtrar por..." />
                                </th>
                                <th class="sortable pointer" onclick="sortTable(2)" style="width: 250px;">
                                    <div class="d-flex align-items-center mb-1">TRABAJADOR <i class="bi bi-arrow-down-up ms-2 x-small opacity-50"></i></div>
                                    <input form="dashboardForm" asp-for="FilterWorker" class="form-control form-control-sm header-filter" placeholder="Nombre..." />
                                </th>
                                <th class="sortable pointer" onclick="sortTable(3)" style="width: 140px;">
                                    <div class="d-flex align-items-center mb-1">TICKET <i class="bi bi-arrow-down-up ms-2 x-small opacity-50"></i></div>
                                    <input form="dashboardForm" asp-for="FilterTicket" class="form-control form-control-sm header-filter" placeholder="ID..." />
                                </th>
                                <th class="text-center sortable pointer" onclick="sortTable(4)" style="width: 120px;">
                                    <div class="d-flex align-items-center justify-content-center">HORAS <i class="bi bi-arrow-down-up ms-2 x-small opacity-50"></i></div>
                                </th>
                                <th class="pe-4" style="width: auto;">
                                    <div class="mb-1">COMENTARIO</div>
                                    <input form="dashboardForm" asp-for="FilterComment" class="form-control form-control-sm header-filter" placeholder="Buscar texto..." />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Worklogs.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 border-0">
                                        <div class="py-5">
                                            <i class="bi bi-inbox fs-1 text-muted opacity-25"></i>
                                            <p class="text-muted mt-3">No se encontraron registros que coincidan.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @foreach (var wl in Model.Worklogs)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="date-badge">
                                            <span class="day">@wl.Started.Day</span>
                                            <span class="month">@wl.Started.ToString("MMM").ToUpper()</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm-modern me-2">
                                                <div class="avatar-box">@wl.AccountName.Substring(0, 1).ToUpper()</div>
                                            </div>
                                            <div class="d-flex flex-column truncate-text" style="max-width: 220px;">
                                                <span class="fw-bold text-dark">@wl.AccountName</span>
                                                <span class="x-small text-muted opacity-75 truncate-text">Jira Account</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(wl.WorkerInComment))
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill x-small px-3">@wl.WorkerInComment</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted opacity-20 small">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@wl.JiraUrl" target="_blank" class="jira-pill-modern">
                                            <i class="bi bi-link-45deg"></i> <span class="fw-black">@wl.IssueKey</span>
                                        </a>
                                    </td>
                                    <td>
                                        <div class="text-center">
                                            <span class="hour-value fw-black text-primary fs-5">@wl.Hours.ToString("F1")</span>
                                            <span class="hour-label x-small text-muted">H</span>
                                        </div>
                                    </td>
                                    <td class="pe-4">
                                        <div class="comment-bubble shadow-none" title="@wl.Comment">
                                            @wl.Comment
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    :root {
        --brand-info: #0dcaf0;
        --brand-primary: #0d6efd;
        --bg-glass: rgba(255, 255, 255, 0.8);
    }

    body, html { height: 100vh; font-family: 'Inter', system-ui, -apple-system, sans-serif; background: #f1f5f9; overflow: hidden; }
    .dashboard-root { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
    .main-layout { flex: 1; display: flex; overflow: hidden; }
    
    /* Loader */
    .loader-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(8px);
        z-index: 9999; display: flex; align-items: center; justify-content: center;
    }

    /* Table & Sroll */
    .table-container { min-height: 0; position: relative; }
    .sticky-top { background: #f8fafc !important; }
    .shadow-card { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }

    .x-small { font-size: 0.65rem; }
    .tracking-widest { letter-spacing: 0.15em; }
    .fw-black { font-weight: 800; }
    .cursor-pointer { cursor: pointer; }
    .pointer { cursor: pointer; }
    .truncate-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* Modern Inputs */
    .header-filter {
        border-radius: 8px; font-size: 0.85rem; 
        background-color: white; border: 1px solid #e2e8f0;
    }

    /* Badges & Avatars */
    .date-badge {
        display: flex; flex-direction: column; align-items: center; background: white;
        border: 1px solid #e2e8f0; border-radius: 10px; width: 48px; padding: 4px;
    }
    .date-badge .day { font-weight: 800; font-size: 1.15rem; color: #1e293b; }
    .date-badge .month { font-size: 0.75rem; color: var(--brand-primary); font-weight: 800; }

    .avatar-sm-modern { width: 40px; height: 40px; padding: 2px; border: 1px solid #e2e8f0; border-radius: 12px; }
    .avatar-box {
        width: 100%; height: 100%; background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800;
    }

    .jira-pill-modern {
        background: #f1f5f9; color: #0052cc !important; font-weight: 800; font-size: 0.8rem;
        padding: 6px 14px; border-radius: 8px; text-decoration: none; border: 1px solid #cbd5e1;
        display: inline-flex; align-items: center; transition: all 0.2s;
    }
    .jira-pill-modern:hover { background: #0052cc; color: white !important; transform: scale(1.05); }

    .comment-bubble {
        max-width: 450px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        font-size: 0.9rem; color: #475569; background: transparent;
    }

    .stat-pill {
        background: rgba(255,255,255,0.1); border-radius: 50px; padding: 5px 15px;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .stat-pill .label { font-size: 0.55rem; font-weight: 800; margin-right: 10px; color: rgba(255,255,255,0.5); }
    .stat-pill .value { font-weight: 900; color: var(--brand-info); }

    .shadow-info { box-shadow: 0 4px 14px 0 rgba(13, 202, 240, 0.39); }
    .shadow-inner { box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05); }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
</style>

<script>
    function showLoader() {
        document.getElementById('globalLoader').classList.remove('d-none');
    }

    function sortTable(n) {
        const table = document.getElementById("worklogTable");
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.querySelectorAll("tr"));
        
        // Skip if empty
        if (rows.length <= 1 && rows[0]?.querySelector('td[colspan]')) return;

        const isAsc = table.getAttribute("data-sort-dir") === "asc";
        const newDir = isAsc ? "desc" : "asc";
        table.setAttribute("data-sort-dir", newDir);

        const sortedRows = rows.sort((a, b) => {
            let x = a.getElementsByTagName("TD")[n].innerText.trim();
            let y = b.getElementsByTagName("TD")[n].innerText.trim();
            
            // Numeric sort for Hours column (index 4)
            if (n === 4) {
                return (parseFloat(x.replace(',', '.')) || 0) - (parseFloat(y.replace(',', '.')) || 0);
            }
            
            // Date sort for Date column (index 0)
            if (n === 0) {
                // The date badge has day and month separately, but let's assume yyyy-mm-dd format if possible 
                // or just compare the text which is "27 FEB" etc (risky). 
                // Better: we can add a hidden timestamp data attribute.
                return x.localeCompare(y, undefined, { numeric: true });
            }

            return x.localeCompare(y, undefined, { sensitivity: 'base' });
        });

        if (newDir === "desc") sortedRows.reverse();

        // Re-append rows in sorted order (single DOM reflow)
        const fragment = document.createDocumentFragment();
        sortedRows.forEach(row => fragment.appendChild(row));
        tbody.appendChild(fragment);

        // Update header icons for visual feedback
        const icons = table.querySelectorAll("thead i.bi-arrow-down-up, thead i.bi-sort-alpha-down, thead i.bi-sort-alpha-up");
        icons.forEach(i => {
           i.className = "bi bi-arrow-down-up ms-2 x-small opacity-50";
        });
        const currentIcon = table.querySelectorAll("thead th")[n].querySelector("i");
        if (currentIcon) {
            currentIcon.className = `bi bi-sort-alpha-${newDir === 'asc' ? 'down' : 'up'} ms-2 x-small text-info`;
        }
    }

    function exportData() {
        showLoader();
        const form = document.getElementById('dashboardForm');
        const virtualForm = document.createElement('form');
        virtualForm.method = 'POST';
        virtualForm.action = '@Url.Action("Export", "Home")';
        new FormData(form).forEach((value, key) => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = key;
            input.value = value;
            virtualForm.appendChild(input);
        });
        document.body.appendChild(virtualForm);
        virtualForm.submit();
        document.body.removeChild(virtualForm);
        
        setTimeout(() => {
            document.getElementById('globalLoader').classList.add('d-none');
        }, 3000);
    }

    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAllSidebar');
        const checkboxes = document.querySelectorAll('.user-cb-sidebar');
        
        selectAll.addEventListener('change', function() {
            checkboxes.forEach(cb => cb.checked = selectAll.checked);
        });

        const headerInputs = document.querySelectorAll('.header-filter');
        
        // Live Filter function
        function liveFilter() {
            const userF = document.getElementById('FilterUser').value.toLowerCase();
            const workerF = document.getElementById('FilterWorker').value.toLowerCase();
            const ticketF = document.getElementById('FilterTicket').value.toLowerCase();
            const commentF = document.getElementById('FilterComment').value.toLowerCase();

            const rows = document.querySelectorAll('#worklogTable tbody tr');
            let vCount = 0;
            let vHours = 0;

            rows.forEach(row => {
                if (row.querySelector('td[colspan]')) return;

                const uText = row.cells[1].innerText.toLowerCase();
                const wText = row.cells[2].innerText.toLowerCase();
                const tText = row.cells[3].innerText.toLowerCase();
                const cText = row.cells[5].innerText.toLowerCase();

                const isVisible = uText.includes(userF) && 
                                  wText.includes(workerF) && 
                                  tText.includes(ticketF) && 
                                  cText.includes(commentF);

                row.style.display = isVisible ? '' : 'none';
                
                if (isVisible) {
                    vCount++;
                    const hVal = parseFloat(row.cells[4].querySelector('.hour-value').innerText.replace(',', '.')) || 0;
                    vHours += hVal;
                }
            });

            // Update UI Counters
            const counterBadge = document.getElementById('recordCountBadge');
            if (counterBadge) counterBadge.innerText = `${vCount} Registros Encontrados`;
            
            const totalHoursDisplay = document.getElementById('totalHoursValue');
            if (totalHoursDisplay) totalHoursDisplay.innerText = vHours.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        headerInputs.forEach(input => {
            input.addEventListener('input', liveFilter);
            input.addEventListener('keyup', function(e) {
                if (e.key === 'Enter') {
                    document.getElementById('dashboardForm').submit();
                }
            });
        });
    });
</script>

<!-- Add Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css">
<!-- Add Inter Font -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
