<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Neo4j Graph Hub</title>
    
    <!-- Fuentes de Google: Outfit para tipografía moderna -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Iconos de Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Neo4jGraphApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark navbar-premium mb-4">
            <div class="container">
                <a class="navbar-brand navbar-brand-glow" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-diagram-3-fill text-purple me-2" style="color: #c084fc;"></i>Neo4j Graph Hub
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-md-4 gap-2">
                        <li class="nav-item">
                            <a class="nav-link nav-link-glow @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                               asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-glow @(ViewContext.RouteData.Values["controller"]?.ToString() == "People" ? "active" : "")" 
                               asp-area="" asp-controller="People" asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i>Personas (Nodes)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-glow @(ViewContext.RouteData.Values["controller"]?.ToString() == "Skills" ? "active" : "")" 
                               asp-area="" asp-controller="Skills" asp-action="Index">
                                <i class="bi bi-gem me-1"></i>Habilidades (Nodes)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-glow @(ViewContext.RouteData.Values["controller"]?.ToString() == "Queries" ? "active" : "")" 
                               asp-area="" asp-controller="Queries" asp-action="Index">
                                <i class="bi bi-terminal-fill me-1"></i>Cypher Sandbox
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center text-secondary gap-2">
                        <span class="badge rounded-pill bg-dark border border-secondary px-3 py-2 text-light" style="font-size: 0.75rem;">
                            <i class="bi bi-cloud-check-fill text-success me-1"></i>Neo4j Active
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <!-- Mensajes del Sistema de TempData -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show glass-panel border-success text-success mb-4" role="alert" style="background: rgba(16, 185, 129, 0.15);">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show glass-panel border-danger text-danger mb-4" role="alert" style="background: rgba(244, 63, 94, 0.15);">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 position-fixed bottom-0 start-0 w-100 mt-auto">
        <div class="container d-flex justify-content-between align-items-center">
            <span>&copy; 2026 - Neo4j Graph Hub - Práctica de CRUD en Grafo</span>
            <div>
                <span class="text-secondary me-3" style="font-size: 0.8rem;">
                    Desarrollado con <i class="bi bi-heart-fill text-danger"></i> + ASP.NET Core & Neo4j
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
