@model Neo4jGraphApp.Models.Person
@{
    ViewData["Title"] = "Crear Nodo Persona";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-3 gap-2">
            <a asp-action="Index" class="btn btn-sm btn-premium btn-premium-outline">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
            <span class="text-secondary">| Directorio</span>
        </div>

        <div class="glass-panel p-4">
            <h2 class="fw-bold mb-1 text-light" style="font-size: 1.6rem;">Crear Nodo de Persona</h2>
            <p class="text-secondary mb-4" style="font-size: 0.9rem;">
                Registra un nuevo nodo <code>(:Person)</code> en tu base de datos Neo4j.
            </p>

            <form asp-action="Create" method="post" class="form-premium d-flex flex-column gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <!-- Nombre -->
                <div>
                    <label asp-for="Name" class="form-label mb-1">Nombre Completo</label>
                    <input asp-for="Name" class="form-control form-control-premium" placeholder="Ej. Juan Pérez" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Cargo / Puesto -->
                <div>
                    <label asp-for="Title" class="form-label mb-1">Cargo Profesional / Puesto</label>
                    <input asp-for="Title" class="form-control form-control-premium" placeholder="Ej. Arquitecto de Cloud, Desarrollador .NET" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <!-- Correo Electrónico -->
                <div>
                    <label asp-for="Email" class="form-label mb-1">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="form-control form-control-premium" placeholder="Ej. juan.perez@empresa.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Biografía -->
                <div>
                    <label asp-for="Bio" class="form-label mb-1">Biografía Corta</label>
                    <textarea asp-for="Bio" rows="4" class="form-control form-control-premium" placeholder="Escribe un breve resumen sobre la experiencia y fortalezas..." required></textarea>
                    <span asp-validation-for="Bio" class="text-danger small"></span>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2 mt-3 border-top border-secondary pt-3">
                    <a asp-action="Index" class="btn btn-premium btn-premium-outline">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-premium btn-premium-purple shadow">
                        <i class="bi bi-save"></i> Guardar Nodo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
