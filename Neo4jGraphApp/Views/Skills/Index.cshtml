@model List<Neo4jGraphApp.Models.Skill>
@{
    ViewData["Title"] = "Catálogo de Habilidades";
}

<div class="row mb-4 align-items-center">
    <div class="col-12">
        <h1 class="fw-bold mb-1" style="font-weight: 800; font-size: 2.2rem; background: linear-gradient(to right, #fff, #34d399); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Catálogo de Habilidades (:Skill)
        </h1>
        <p class="text-secondary" style="font-size: 1rem;">
            Administra el catálogo de tecnologías y aptitudes que luego asociarás a los perfiles profesionales.
        </p>
    </div>
</div>

<div class="row g-4">
    <!-- Columna Izquierda: Registro Rápido de Habilidades (Formulario) -->
    <div class="col-lg-4">
        <div class="glass-panel p-4">
            <h3 class="fw-bold mb-1 text-light" style="font-size: 1.25rem;">
                <i class="bi bi-plus-square text-emerald me-2"></i>Agregar Habilidad
            </h3>
            <p class="text-secondary mb-4" style="font-size: 0.85rem;">
                Crea un nuevo nodo del tipo <code>:Skill</code>.
            </p>

            <form asp-action="Create" method="post" class="form-premium d-flex flex-column gap-3">
                <!-- Nombre de la Habilidad -->
                <div>
                    <label class="form-label mb-1">Nombre de la Habilidad</label>
                    <input name="Name" class="form-control form-control-premium" placeholder="Ej. Neo4j, ASP.NET Core, React" required />
                </div>

                <!-- Categoría -->
                <div>
                    <label class="form-label mb-1">Categoría</label>
                    <select name="Category" class="form-control form-control-premium" required>
                        <option value="Languages">Lenguajes de Programación (Languages)</option>
                        <option value="Backend">Desarrollo Backend (Backend)</option>
                        <option value="Frontend">Desarrollo Frontend (Frontend)</option>
                        <option value="Databases" selected>Bases de Datos (Databases)</option>
                        <option value="Cloud">Computación en la Nube (Cloud)</option>
                        <option value="DevOps">Herramientas DevOps (DevOps)</option>
                        <option value="Methodologies">Metodologías / Otros (Methodologies)</option>
                    </select>
                </div>

                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-premium btn-premium-purple" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                        <i class="bi bi-file-earmark-plus"></i> Registrar Nodo
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Columna Derecha: Catálogo de Habilidades -->
    <div class="col-lg-8">
        <div class="glass-panel p-4 h-100">
            <h3 class="fw-bold mb-3 text-light" style="font-size: 1.25rem;">Catálogo Registrado</h3>

            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-secondary border border-dashed rounded border-secondary" style="background: rgba(0,0,0,0.15);">
                    <i class="bi bi-gem" style="font-size: 3rem; opacity: 0.4;"></i>
                    <h5 class="mt-3 text-light">No hay habilidades registradas</h5>
                    <p class="mb-0" style="font-size: 0.85rem;">Utiliza el formulario de la izquierda para agregar habilidades tecnológicas.</p>
                </div>
            }
            else
            {
                <!-- Listado agrupado por categorías de forma dinámica -->
                <div class="row g-3">
                    @foreach (var group in Model.GroupBy(s => s.Category))
                    {
                        <div class="col-12 mt-4 first:mt-0">
                            <h5 class="fw-bold text-secondary text-uppercase border-bottom border-secondary pb-2 mb-3" style="font-size: 0.8rem; letter-spacing: 1px;">
                                <i class="bi bi-tag-fill me-1 text-emerald"></i> @group.Key (@group.Count())
                            </h5>
                            
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var skill in group)
                                {
                                    <div class="skill-tag px-3 py-2 d-flex align-items-center gap-2" style="background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.07); color: #fff;">
                                        <i class="bi bi-hash text-emerald"></i>
                                        <span>@skill.Name</span>
                                        
                                        <!-- Eliminar Habilidad -->
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente esta habilidad? Esto la desvinculará automáticamente de todos los perfiles profesionales en el grafo.');" class="d-inline ms-1">
                                            <input type="hidden" name="id" value="@skill.Id" />
                                            <button type="submit" class="border-0 bg-transparent text-danger p-0 align-middle" style="line-height: 0;">
                                                <i class="bi bi-x-circle-fill" style="font-size: 0.9rem; cursor: pointer;"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
